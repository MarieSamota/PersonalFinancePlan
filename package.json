{
  "name": "finance_plan",
  "version": "1.0.0",
  "description": "Система для построения персонального финансового плана",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node -r dotenv/config ./node_modules/sequelize-cli/lib/sequelize db:migrate",
    "db:migrate:undo": "node -r dotenv/config ./node_modules/sequelize-cli/lib/sequelize db:migrate:undo",
    "db:seed": "node -r dotenv/config ./node_modules/sequelize-cli/lib/sequelize db:seed:all",
    "db:seed:undo": "node -r dotenv/config ./node_modules/sequelize-cli/lib/sequelize db:seed:undo:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
