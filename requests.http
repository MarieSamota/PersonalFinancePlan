@baseUrl = http://localhost:3000
@token = {{login.response.body.$.token}}

### Регистрация
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "maria@example.com",
  "password": "supersecret1"
}

### Повторная регистрация тем же email (ожидается 400)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "maria@example.com",
  "password": "supersecret1"
}

### Регистрация без пароля (ожидается 400)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "broken@example.com"
}

### Вход до подтверждения email (ожидается 403)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "maria@example.com",
  "password": "supersecret1"
}

### Вход с неверным паролем (ожидается 401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "maria@example.com",
  "password": "неверный-пароль"
}

### Подтверждение email (вставь токен, который сервер напечатал в консоли после первой регистрации)
GET {{baseUrl}}/auth/verify-email/ВСТАВЬ_ТОКЕН_ИЗ_КОНСОЛИ

### Вход после подтверждения (ожидается 200 и токен)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "maria@example.com",
  "password": "supersecret1"
}

### Профиль с валидным токеном
GET {{baseUrl}}/profile
Authorization: Bearer {{token}}

### Профиль без токена (ожидается 401)
GET {{baseUrl}}/profile

### Транзакции без токена (ожидается 401)
GET {{baseUrl}}/transactions

###
GET {{baseUrl}}/transactions
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/transactions?type=expense
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/transactions?category=Продукты
Authorization: Bearer {{token}}

### Поиск по подстроке в категории и описании
GET {{baseUrl}}/transactions?search=прод
Authorization: Bearer {{token}}

### Поиск без совпадений (ожидается пустой массив)
GET {{baseUrl}}/transactions?search=несуществующее
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/transactions/1
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/transactions/999
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/transactions/abc
Authorization: Bearer {{token}}

###
POST {{baseUrl}}/transactions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 3500,
  "type": "expense",
  "category": "Кафе",
  "date": "2026-09-02",
  "description": "Обед с другом"
}

###
POST {{baseUrl}}/transactions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 100000,
  "type": "income",
  "category": "Зарплата"
}

###
POST {{baseUrl}}/transactions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "salary",
  "category": ""
}

###
POST {{baseUrl}}/transactions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 500,
}

###
PUT {{baseUrl}}/transactions/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 45,
  "type": "expense",
  "category": "Продукты",
  "date": "2026-09-03",
  "description": "Магазин у дома"
}

###
PUT {{baseUrl}}/transactions/999
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 10,
  "type": "income",
  "category": "Прочее"
}

###
PUT {{baseUrl}}/transactions/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": -5,
  "type": "expense",
  "category": "Продукты"
}

###
DELETE {{baseUrl}}/transactions/3
Authorization: Bearer {{token}}

### (повторный)
DELETE {{baseUrl}}/transactions/3
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/
