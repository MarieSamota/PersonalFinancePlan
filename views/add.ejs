<%- include('partials/header') %>

<div class="page-top">
  <h1>Новая транзакция</h1>
</div>

<div class="card">
  <% if (errors.length > 0) { %>
    <ul class="errors">
      <% errors.forEach(function (e) { %>
        <li><%= e %></li>
      <% }); %>
    </ul>
  <% } %>

  <form method="post" action="/add<%= authQuery %>">
    <div class="field">
      <label for="amount">Сумма</label>
      <input type="text" inputmode="decimal" autocomplete="off" maxlength="18" id="amount" name="amount" value="<%= values.amount || '' %>">
    </div>
    <div class="field">
      <label for="type">Тип</label>
      <select id="type" name="type">
        <option value="income" <%= values.type === "income" ? "selected" : "" %>>Доход</option>
        <option value="expense" <%= values.type === "expense" ? "selected" : "" %>>Расход</option>
      </select>
    </div>
    <div class="field">
      <label for="category">Категория</label>
      <input type="text" id="category" name="category" maxlength="50" value="<%= values.category || '' %>">
    </div>
    <div class="field">
      <label for="date">Дата</label>
      <input type="date" id="date" name="date" value="<%= values.date || '' %>">
    </div>
    <div class="field">
      <label for="description">Название</label>
      <input type="text" id="description" name="description" maxlength="50" value="<%= values.description || '' %>">
    </div>
    <div class="field">
      <label class="check">
        <input type="checkbox" name="isRecurring" <%= values.isRecurring ? "checked" : "" %>>
        Регулярная транзакция
      </label>
    </div>
    <button class="btn" type="submit">Добавить</button>
  </form>
</div>

<script>
  const amountInput = document.getElementById("amount");
  amountInput.addEventListener("input", () => {
    let value = amountInput.value.replace(",", ".").replace(/[^\d.]/g, "");
    const dot = value.indexOf(".");
    if (dot !== -1) {
      value = value.slice(0, dot + 1) + value.slice(dot + 1).replace(/\./g, "");
    }
    const [whole, fraction] = value.split(".");
    value = whole.slice(0, 15);
    if (fraction !== undefined) {
      value += "." + fraction.slice(0, 2);
    }
    amountInput.value = value;
  });
</script>

<%- include('partials/footer') %>